{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "shotlist.json",
 "description": "分镜表。meta 为整组共用信息，shots 至少 9 条。make_cards.py 直接读取本文件。",
 "type": "object",
 "required": [
  "meta",
  "shots"
 ],
 "properties": {
  "meta": {
   "type": "object",
   "required": [
    "place",
    "date",
    "arrive",
    "gear",
    "sun"
   ],
   "properties": {
    "place": {
     "type": "string"
    },
    "date": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "arrive": {
     "type": "string"
    },
    "close": {
     "type": "string"
    },
    "gear": {
     "type": "string",
     "description": "机身 + 镜头焦段范围，例：全画幅机身 + 24-105mm F4"
    },
    "body": {
     "type": "string"
    },
    "flash_unit": {
     "type": "string"
    },
    "look_policy": {
     "type": "string",
     "description": "创意外观 / 白平衡策略"
    },
    "forecast": {
     "type": "string"
    },
    "sun": {
     "type": "object",
     "additionalProperties": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
     },
     "description": "{\"HH:MM\": [方位角, 高度角]}，从 sun.json 的 rows 取整点与半点"
    },
    "terrain_note": {
     "type": "string"
    },
    "layout": {
     "type": "string"
    },
    "outfit": {
     "type": "string"
    },
    "rules": {
     "type": "string"
    },
    "version": {
     "type": "string"
    },
    "sns": {
     "type": "string"
    },
    "route_stops": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "name",
       "shots"
      ],
      "properties": {
       "name": {
        "type": "string"
       },
       "shots": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "note": {
        "type": "string"
       }
      }
     },
     "description": "园内游览顺序：每站列分镜 id（拍摄顺序）；tools/route.py 据此沿步道算路线（docs/ROUTE_NOTES.md）"
    },
    "route_source": {
     "type": "string",
     "description": "路线依据：官网順路 / 攻略 / 预报"
    },
    "route_speed_mps": {
     "type": "number",
     "description": "步行速度 m/s，默认 1.0，雨天 0.85"
    },
    "transport": {
     "type": "string"
    }
   }
  },
  "shots": {
   "type": "array",
   "minItems": 9,
   "items": {
    "type": "object",
    "required": [
     "id",
     "title",
     "time",
     "spot",
     "kind",
     "lens",
     "shutter",
     "camera",
     "subject",
     "light",
     "action",
     "alt",
     "note",
     "cam_bearing",
     "cam_dist",
     "bg_bearing",
     "bg_label",
     "face_bearing",
     "size",
     "role",
     "pose",
     "gaze"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^\\d{2}$"
     },
     "title": {
      "type": "string"
     },
     "time": {
      "type": "string",
      "description": "HH:MM–HH:MM，或含时刻的说明文字"
     },
     "spot": {
      "type": "string"
     },
     "bg_dir": {
      "type": "string"
     },
     "kind": {
      "type": "string",
      "description": "景别：特写 / 近景 / 半身 / 七分 / 全身 / 环境远景"
     },
     "lens": {
      "type": "string",
      "description": "只从器材里选，例：85mm F4"
     },
     "shutter": {
      "type": "string"
     },
     "camera": {
      "type": "string",
      "description": "机位：高度、方位、距离"
     },
     "subject": {
      "type": "string",
      "description": "站位与朝向"
     },
     "light": {
      "type": "string",
      "description": "来源—落点—结果；晴天版引用 sun.md 的方位/高度"
     },
     "fg_bg": {
      "type": "string"
     },
     "action": {
      "type": "string",
      "description": "对模特说的一句话"
     },
     "alt": {
      "type": "string",
      "description": "晴天/阴天/雨天备选"
     },
     "note": {
      "type": "string"
     },
     "cam_bearing": {
      "type": "number",
      "description": "相机相对人物的方位角（正北 0，顺时针）"
     },
     "cam_dist": {
      "type": "number",
      "description": "米"
     },
     "bg_bearing": {
      "type": "number"
     },
     "bg_label": {
      "type": "string"
     },
     "face_bearing": {
      "type": "number"
     },
     "size": {
      "type": "string",
      "pattern": "^\\d+x\\d+$"
     },
     "look": {
      "type": "string"
     },
     "flash": {
      "type": "string"
     },
     "subject_latlon": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
     },
     "basemap": {
      "type": "string",
      "default": "main",
      "description": "俯视图用哪张底图：basemaps/<name>_styled.png"
     },
     "map_window_m": {
      "type": "number",
      "default": 84,
      "description": "俯视图裁切宽度（米）"
     },
     "alt_time": {
      "type": "string",
      "description": "晴天版建议时刻 HH:MM，俯视图太阳箭头按此取 meta.sun"
     },
     "indoor": {
      "type": "boolean",
      "description": "true 时不画太阳与散射光箭头"
     },
     "topview_note": {
      "type": "string",
      "description": "覆盖俯视图左上角说明文字"
     },
     "img_from": {
      "type": "string",
      "description": "复用上一版本图片时记录来源编号"
     },
     "images": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "参考图（走 edit 模式）"
     },
     "role": {
      "type": "string",
      "enum": [
       "opening",
       "context",
       "interaction",
       "portrait",
       "detail",
       "closing"
      ],
      "description": "叙事角色（docs/SHOT_DESIGN.md）：opening 开场、context 环境、interaction 互动/动作、portrait 肖像、detail 细节、closing 收尾"
     },
     "hero": {
      "type": "boolean",
      "description": "主图：这组的代表作，至少一张"
     },
     "pose": {
      "type": "string",
      "enum": [
       "stand",
       "walk",
       "sit",
       "lean",
       "back",
       "crouch"
      ],
      "description": "姿态，全组至少三种"
     },
     "gaze": {
      "type": "string",
      "enum": [
       "camera",
       "away",
       "down",
       "closed",
       "back"
      ],
      "description": "视线；看镜头不超过 60%"
     },
     "optional": {
      "type": "boolean",
      "description": "备选/机动分镜：不参与首尾与相邻节奏检查"
     },
     "supplement": {
      "type": "boolean",
      "description": "补充条目（连拍/短片/实况等加在静态分镜之后）：不参与首尾与相邻检查"
     },
     "medium": {
      "type": "string",
      "enum": [
       "still",
       "burst",
       "video",
       "live"
      ],
      "description": "介质：still 静态照片（缺省）、burst 连拍抓动态（出照片）、video 相机短片、live 手机实况；见 docs/VIDEO_NOTES.md"
     },
     "burst": {
      "type": "object",
      "properties": {
       "fps": {
        "type": "number"
       },
       "precap_s": {
        "type": "number"
       },
       "action": {
        "type": "string"
       }
      },
      "description": "连拍：帧率、预拍秒数、动作与选片说明"
     },
     "clip": {
      "type": "object",
      "required": [
       "mode",
       "move",
       "start",
       "end"
      ],
      "properties": {
       "mode": {
        "type": "string",
        "enum": [
         "24p",
         "sq60",
         "sq120"
        ]
       },
       "move": {
        "type": "string",
        "description": "运镜名（docs/VIDEO_NOTES.md 第 5 节）"
       },
       "dur_s": {
        "type": "number",
        "description": "实录秒数，实时 ≤ 5"
       },
       "start": {
        "type": "string"
       },
       "end": {
        "type": "string"
       },
       "nd": {
        "type": "string"
       },
       "exposure": {
        "type": "string",
        "description": "本条曝光基准，例：脸放斑马 52%"
       },
       "move_type": {
        "type": "string",
        "enum": [
         "tilt_down_reveal",
         "wipe_reveal",
         "track_side",
         "track_behind",
         "track_front",
         "push_in",
         "orbit_quarter",
         "static_turn",
         "static",
         "pull_back_tilt_up",
         "static_walk_out"
        ],
        "description": "运镜示意页用的类型；不写时按 move 文字判断"
       },
       "cam_h": {
        "type": "number",
        "description": "机位高度（米），不写时从 camera 文字判断"
       },
       "walk_m": {
        "type": "number",
        "description": "跟拍时人物走的距离（米），默认 0.8 m/s × 运动秒数"
       },
       "tilt_start": {
        "type": "number",
        "description": "下摇起始仰角（度），默认 35"
       },
       "tilt_end": {
        "type": "number",
        "description": "后拉上摇结束仰角（度），默认 22"
       },
       "orbit_side": {
        "type": "string",
        "enum": [
         "left",
         "right"
        ],
        "description": "环绕从人物哪一侧起"
       },
       "cam_dist_start": {
        "type": "number"
       },
       "cam_dist_end": {
        "type": "number"
       }
      }
     },
     "live": {
      "type": "object",
      "properties": {
       "device": {
        "type": "string"
       },
       "lens": {
        "type": "string"
       },
       "exposure": {
        "type": "string"
       },
       "action": {
        "type": "string"
       }
      }
     },
     "src": {
      "type": "object",
      "description": "这张分镜照着哪条 SNS 素材设计（v5 起分镜卡右侧的来源栏与核对表的来源行都从这里来）。没有对应素材的补充分镜写 {\"ref\": \"\", \"kind\": \"无 SNS 素材\", \"what\": \"补充分镜：…\"}。规则见 docs/SNS_NOTES.md。",
      "required": [
       "ref",
       "kind",
       "what"
      ],
      "properties": {
       "ref": {
        "type": "string",
        "description": "sns_refs.json 里的编号：机位帖 Sxx、姿势帖 Xx、平台汇总 Qx；补充分镜为空字符串"
       },
       "kind": {
        "type": "string",
        "enum": [
         "机位帖",
         "姿势帖",
         "平台汇总",
         "无 SNS 素材"
        ]
       },
       "platform": {
        "type": "string",
        "description": "小红书 / Instagram / 抖音 / TikTok"
       },
       "title": {
        "type": "string",
        "description": "原帖标题（平台汇总写检索词与汇总篇数）"
       },
       "url": {
        "type": "string",
        "description": "原帖或搜索页链接，卡片上生成二维码"
       },
       "posted": {
        "type": "string",
        "description": "发帖日期；平台汇总写浏览日期"
       },
       "level": {
        "type": "string",
        "enum": [
         "高",
         "中",
         "低"
        ],
        "description": "机位帖的可复现度"
       },
       "why": {
        "type": "string",
        "description": "可复现度的理由与今天现场的差异（季节、天气、人流）"
       },
       "likes": {
        "type": "integer"
       },
       "what": {
        "type": "string",
        "description": "照搬了原帖的什么：机位、焦段、构图、姿势中的哪些"
       },
       "pose_id": {
        "type": "string",
        "description": "姿势帖里的姿势编号 Pxx"
       },
       "pose_name": {
        "type": "string"
       },
       "pose_how": {
        "type": "string",
        "description": "姿势要领，一句话"
       },
       "also": {
        "type": "array",
        "items": {
         "type": "string"
        },
        "description": "同一张还参考的其它素材，如「X1 P05 撑伞侧身看镜头」"
       }
      }
     }
    }
   }
  }
 }
}